# BiguaSim T2 SITL overrides — ArduPilot NAME VALUE format (2-column)

# Frame
FRAME_CLASS 1
FRAME_TYPE 1

# Don't yaw to face each waypoint (prevents heading-error-induced spin)
WP_YAW_BEHAVIOR 0

# BiguaSim _unipolar_pwm is LINEAR (omega proportional to PWM).
# Default expo=0.65 expects curved thrust; set to 0 for linear match.
MOT_THST_EXPO 0.0

# BiguaSim DjiMatrice hover omega ≈ 374.8 / 592.4 max ≈ 0.633 of max throttle
MOT_THST_HOVER 0.633

# Safe navigation speed/accel for simulation (default is 10 m/s which is too fast)
WPNAV_SPEED 200
WPNAV_ACCEL 100
# Faster vertical descent so the drone crosses the EKF-glitch zone quickly
WPNAV_SPEED_DN 400

# Reject GPS jumps > 5m as glitches (default 25m accepts the ~17m BiguaSim GPS
# artifact that fires when the drone descends past the bridge deck level,
# causing a false EKF horizontal reset and restarting the approach loop).
EK3_GLITCH_RAD 5

# Increase GPS altitude noise so EKF trusts barometer over GPS for altitude.
# Prevents the GPS altitude glitch (same trigger as the horizontal one) from
# causing the controller to think the drone is below the target and ascend.
EK3_ALT_M_NSE 20

# Tilt limit 30°
ANGLE_MAX 3000

# Keep the velocity setpoint active for 15 s after the last MAVLink message.
# With 2 m/s descent and spawn at bsim_z=18.4 m, the drone travels 30 m in 15 s,
# reaching bsim_z=-11.6 m (target depth). AQUATIC_NAV triggers at ~10.7 s (before
# timeout), so the mission advances while the drone is still descending.
GUID_TIMEOUT 15

# Prevent ArduPilot from auto-disarming when the drone rests on the river bottom.
# Default DISARM_DELAY=10s would disarm motors while the drone is still underwater,
# making it unable to execute the ascent and land steps after the ROV tour.
DISARM_DELAY 0

# EKF health — SITL tolerances
# FS_EKF_ACTION 0: warn only, don't change flight mode when EKF variance spikes.
# BiguaSim GPS synthesizer produces position jumps at bridge-deck level and during
# AHRS init; default action=1 (AltHold) would interrupt the landing sequence.
FS_EKF_ACTION 0
# Relax innovation check scale from default 100 to 200 so transient GPS artifacts
# (bridge-deck crossing, SITL GPS lock settling) don't trip the EKF health flag.
EK3_CHECK_SCALE 200

# GCS/heartbeat failsafe off. Confirmed live: a MAVROS "HEARTBEAT timed out"
# (host CPU contention from running BiguaSim + ArduCopter SITL + the Humble
# container together, made worse by concurrent diagnostic `docker exec` calls
# during a run) triggered ArduCopter's default GCS-failsafe RTL mid-mission —
# not a real link loss, a false positive from a momentarily busy host. Same
# rationale as FS_EKF_ACTION above: disable the SITL-only failure mode instead
# of chasing host timing.
FS_GCS_ENABLE 0

# RC/throttle failsafe off, same rationale as FS_GCS_ENABLE just above: added
# after FS_GCS_ENABLE 0 alone did NOT stop a second live RTL (still saw
# "HEARTBEAT timed out" + mode: RTL) — NOT yet confirmed live whether this was
# the actual second cause or whether FS_GCS_ENABLE simply hadn't taken effect
# (the verification check hung before it could be confirmed either way). No
# real RC transmitter exists in this SITL setup, so this failsafe can never
# fire for a legitimate reason here.
FS_THR_ENABLE 0

# Scheduler's own expected loop rate — SEPARATE parameter from SIM_RATE_HZ
# (set via t2_sitl_run.sh's -A "--rate ..."), confirmed by reading
# AP_Arming.cpp's "Main loop slow" check directly: it compares against
# AP::scheduler().get_loop_rate_hz(), which reads THIS param
# (AP_Scheduler.cpp's "LOOP_RATE" GROUPINFO, default 400 — SCHEDULER_DEFAULT_
# LOOP_RATE), not SIM_RATE_HZ. Setting only SIM_RATE_HZ did NOT clear the
# "Main loop slow" warning live — confirmed the two rates are independent,
# both need to match BiguaSim's real delivery rate.
#
# 200 (biguasim_sim_runner.py's --ticks default / -TicksPerSec=200) is only
# BiguaSim's REQUESTED tick rate, not what it actually sustains: confirmed
# live the real delivered rate is ~133Hz — identically, with AND without
# --viewport (so it's not rendering/GPU load; more likely the Python/PyTorch
# dynamics step itself, or the UDP lockstep round-trip), and stable across
# very different GPU temperatures (65°C vs 86°C) — a real, roughly-fixed
# throughput ceiling for this machine, not a moving thermal-throttling
# target like the 150Hz attempt looked like at first. Set to 120 (margin
# under the observed ~133Hz, since arming requires actual >= 90% of this
# value) —
# must be changed together with t2_sitl_run.sh's -A "--rate ..." if this
# machine's real achievable rate turns out to be different, or if
# --viewport is ever dropped (headless likely sustains a higher real rate,
# since it skips rendering — hasn't been measured).
SCHED_LOOP_RATE 120
